#!/bin/bash

metadata=$(cmus-remote --query)
file=$(printf '%s\n' "$metadata" |
  awk '$1 == "file" { sub(/^[^[:space:]]+[[:space:]]+/, ""); print; exit }')

if [[ -z "$file" ]]; then
  echo "No current file reported by cmus" >&2
  exit 1
fi

if gio trash "$file"; then
  cmus-remote --raw "win-sel-cur"
  cmus-remote --raw "echo gio trash {}"
  cmus-remote --raw "win-remove"
else
  echo "Failed to move file to trash: $file" >&2
  exit 1
fi
